[ti:幻想郷幻想華]
[al:くるいちご煮]
[ar:Crazy Berry]
[cv:https://upload.thbwiki.cc/thumb/d/d6/%E3%81%8F%E3%82%8B%E3%81%84%E3%81%A1%E3%81%94%E7%85%AE%E5%B0%81%E9%9D%A2.jpg/400px-%E3%81%8F%E3%82%8B%E3%81%84%E3%81%A1%E3%81%94%E7%85%AE%E5%B0%81%E9%9D%A2.jpg]
