[ti:ネクロファンタジア]
[al:CREVICE]
[ar:トマト組（tomato-gummy）]
[cv:https://upload.thbwiki.cc/thumb/4/4d/CREVICE%EF%BC%88%E3%83%88%E3%83%9E%E3%83%88%E7%B5%84%EF%BC%89%E5%B0%81%E9%9D%A2.jpg/400px-CREVICE%EF%BC%88%E3%83%88%E3%83%9E%E3%83%88%E7%B5%84%EF%BC%89%E5%B0%81%E9%9D%A2.jpg]
