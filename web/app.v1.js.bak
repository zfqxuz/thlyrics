/* 东方同人曲学唱机 —— 前端逻辑（无构建、无依赖，直接开 index.html 也能跑） */
(() => {
  'use strict';

  const $ = (id) => document.getElementById(id);
  const LS_KEY = 'thlyrics.state.v1';
  const INTERVALS = [1, 3, 7];

  let IDX = null;          // 数据集
  let VOCAB = [];          // 词表数组
  let VBY = new Map();     // 词 -> 词条
  let trackById = new Map();
  let S = freshState();
  let session = { queue: [], i: 0, flipped: false, right: 0, wrong: 0 };
  let cur = null;          // 当前歌词页状态
  let speakQueue = null;

  // ---------- 状态 ----------
  function freshState() {
    return { words: {}, songs: {}, days: [], settings: { hide: false, romaji: true } };
  }
  function load() {
    try {
      const raw = localStorage.getItem(LS_KEY);
      if (raw) S = Object.assign(freshState(), JSON.parse(raw));
    } catch { /* 忽略损坏的本地进度 */ }
    if (!S.words) S.words = {};
    if (!S.songs) S.songs = {};
    if (!Array.isArray(S.days)) S.days = [];
  }
  function save() { try { localStorage.setItem(LS_KEY, JSON.stringify(S)); } catch {} }
  const todayStr = (d = new Date()) =>
    `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  const addDays = (n) => { const d = new Date(); d.setDate(d.getDate() + n); return todayStr(d); };
  function markToday() { if (!S.days.includes(todayStr())) { S.days.push(todayStr()); S.days = S.days.slice(-400); } }
  function streak() {
    let n = 0; const d = new Date();
    for (;;) {
      if (S.days.includes(todayStr(d))) { n++; d.setDate(d.getDate() - 1); }
      else if (n === 0 && S.days.includes(todayStr(new Date(Date.now() - 864e5)))) { d.setDate(d.getDate() - 1); }
      else break;
    }
    return n;
  }
  const st = (w) => S.words[w.id];
  const isKnown = (w) => st(w)?.st === 'known';
  const isDue = (w) => { const s = st(w); return s && s.st !== 'known' && s.due && s.due <= todayStr(); };
  const isNew = (w) => !st(w);

  function grade(w, ok) {
    const t = todayStr();
    const s = S.words[w.id] || { st: 'learning', streak: 0, due: t, seen: 0, wrong: 0 };
    s.seen++;
    if (ok) {
      s.streak++;
      if (s.streak >= 3) { s.st = 'known'; s.due = null; }
      else { s.st = 'learning'; s.due = addDays(INTERVALS[Math.min(s.streak - 1, INTERVALS.length - 1)]); }
    } else {
      s.streak = 0; s.st = 'learning'; s.wrong++; s.due = addDays(1);
    }
    S.words[w.id] = s;
    markToday(); save();
  }

  // ---------- 发音 ----------
  let jaVoice = null;
  function pickVoice() {
    const vs = speechSynthesis.getVoices() || [];
    jaVoice = vs.find((v) => v.lang && v.lang.toLowerCase().startsWith('ja')) || null;
  }
  if (typeof speechSynthesis !== 'undefined') {
    pickVoice();
    speechSynthesis.onvoiceschanged = pickVoice;
  }
  function speak(text, onend) {
    if (!('speechSynthesis' in window)) { onend && onend(); return; }
    speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text);
    u.lang = 'ja-JP';
    if (jaVoice) u.voice = jaVoice;
    u.rate = 0.92;
    u.onend = () => onend && onend();
    u.onerror = () => onend && onend();
    speechSynthesis.speak(u);
  }
  const cleanForTTS = (s) => s.replace(/[（(].*?[)）]/g, '').replace(/[「」『』【】]/g, '');

  /** 顺序朗读整首（逐行高亮） */
  function playAll(lines, els, btn) {
    if (speakQueue) { stopSpeak(); return; }
    const items = lines.map((l, i) => ({ l, i })).filter((x) => x.l.text.trim());
    if (!items.length) return;
    btn.textContent = '■ 停止';
    speakQueue = { stop: false };
    const step = (k) => {
      if (!speakQueue || speakQueue.stop || k >= items.length) { stopSpeak(); return; }
      const { l, i } = items[k];
      els.forEach((e, j) => e.classList.toggle('playing', j === i));
      els[i] && els[i].scrollIntoView({ block: 'center', behavior: 'smooth' });
      speak(cleanForTTS(l.text), () => step(k + 1));
    };
    step(0);
  }
  function stopSpeak() {
    if (speakQueue) speakQueue.stop = true;
    speakQueue = null;
    if ('speechSynthesis' in window) speechSynthesis.cancel();
    const b = $('b-playall'); if (b) b.textContent = '▶ 顺序朗读';
    document.querySelectorAll('.line.playing').forEach((e) => e.classList.remove('playing'));
  }

  // ---------- 词表渲染（弹层 / 卡片共用） ----------
  function showPop(w, extra) {
    $('p-word').textContent = w.word;
    $('p-reading').textContent = w.reading ? '（' + w.reading + '）' : '';
    $('p-romaji').textContent = w.romaji || '';
    const forms = Object.keys(w.forms || {}).filter((f) => f !== w.word).slice(0, 4);
    const bits = [];
    if (w.pos) bits.push(w.pos);
    if (w.count) bits.push(`全库出现 ${w.count} 次 / ${w.tracks.length} 首`);
    if (forms.length) bits.push('歌词里的形态：' + forms.join('、'));
    if (extra) bits.push(extra);
    $('p-meta').textContent = bits.join(' · ');
    const pop = $('pop');
    pop.dataset.wid = w.id;
    pop.classList.add('on');
    $('p-known').textContent = isKnown(w) ? '取消已掌握' : '标为已掌握';
  }
  const hidePop = () => $('pop').classList.remove('on');

  // ---------- Tab ----------
  function setTab(name) {
    document.querySelectorAll('nav.tabs button').forEach((b) => b.classList.toggle('active', b.dataset.tab === name));
    document.querySelectorAll('.panel').forEach((p) => p.classList.toggle('active', p.id === 'panel-' + name));
    if (name !== 'lyrics') stopSpeak();
    if (name === 'cards') startSession();
    if (name === 'vocab') renderVocab();
    if (name === 'stats') renderStats();
    window.scrollTo({ top: 0 });
  }

  // ---------- 歌词页 ----------
  function esc(s) { return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); }

  function renderIndex(filter = '') {
    const list = $('tracklist');
    const f = filter.trim().toLowerCase();
    const hits = IDX.tracks.filter((t) =>
      !f || t.title.toLowerCase().includes(f) || t.artist.toLowerCase().includes(f) ||
      t.album.toLowerCase().includes(f) || t.base.toLowerCase().includes(f));

    if (!hits.length) { list.innerHTML = '<div class="empty">没有匹配的曲目</div>'; return; }

    // 有筛选就平铺，没筛选按原曲分组
    const groups = new Map();
    for (const t of hits) {
      const key = f ? '' : t.base;
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key).push(t);
    }
    const keys = [...groups.keys()].sort((a, b) => groups.get(b).length - groups.get(a).length);

    let html = '';
    for (const k of keys) {
      const arr = groups.get(k);
      if (k) html += `<div class="grouphead">原曲：${esc(k)} · ${arr.length} 个版本</div>`;
      html += '<div class="tracklist">';
      for (const t of arr) {
        const known = t.vocabIds.filter((id) => isKnown(VOCAB[id - 1])).length;
        const pct = t.vocabIds.length ? Math.round((known / t.vocabIds.length) * 100) : 0;
        const img = t.coverFile ? `<img loading="lazy" src="data/${t.coverFile}" alt="">` : '<img alt="">';
        html += `<div class="card track" data-tid="${t.id}">
          ${img}
          <div class="t-main">
            <div class="t-title">${esc(t.title)}${t.timing ? '<span class="badge timing">有时间轴</span>' : ''}</div>
            <div class="t-sub">${esc(t.artist)} · ${esc(t.album)} · ${t.lineCount} 行</div>
            <div class="t-sub">词汇掌握 ${known}/${t.vocabIds.length}（${pct}%）</div>
          </div>
        </div>`;
      }
      html += '</div>';
    }
    list.innerHTML = html;
    list.querySelectorAll('.track').forEach((el) => (el.onclick = () => openTrack(el.dataset.tid)));
  }

  function openTrack(id) {
    const t = trackById.get(id);
    if (!t) return;
    stopSpeak();
    const known = t.vocabIds.filter((i) => isKnown(VOCAB[i - 1])).length;
    const rec = S.songs[t.id];
    $('lyric-index').style.display = 'none';
    const view = $('lyric-view');
    view.style.display = 'block';
    view.innerHTML = `
      <div class="toolbar">
        <button class="btn" id="b-back">← 返回列表</button>
        <button class="btn primary" id="b-playall">▶ 顺序朗读</button>
        <button class="btn" id="b-hide">${S.settings.hide ? '显示全部汉字' : '只高亮没学的词'}</button>
        <button class="btn" id="b-romaji">${S.settings.romaji === false ? '显示罗马音' : '隐藏罗马音'}</button>
        <button class="btn" id="b-mastered">${rec?.mastered ? '✓ 已能脱稿' : '标记能脱稿'}</button>
      </div>
      <div class="card lyrictop">
        ${t.coverFile ? `<img src="data/${t.coverFile}" alt="">` : ''}
        <div>
          <h2>${esc(t.title)}</h2>
          <div class="meta">${esc(t.artist)} · ${esc(t.album)}</div>
          <div class="meta">原曲：${esc(t.base)} · 词汇掌握 ${known}/${t.vocabIds.length}${t.timing ? ' · 自带时间轴' : ''}</div>
          <div class="meta">${rec ? `练过 ${rec.n} 次 · 最佳 ${rec.best}%` : '还没练过'}</div>
        </div>
      </div>
      <div class="card lyric" id="lyric"></div>
      <div class="hint">点任意词看读音和罗马音 · 点句子空白处可整句朗读 · ${t.source ? `<a href="${t.source}" target="_blank" rel="noreferrer">THBWiki 词条</a>` : ''}</div>
    `;

    drawLyric(t);

    $('b-back').onclick = () => { stopSpeak(); view.style.display = 'none'; view.innerHTML = ''; $('lyric-index').style.display = 'block'; renderIndex($('q').value); };
    $('b-playall').onclick = () => playAll(t.lines, [...document.querySelectorAll('#lyric .line')], $('b-playall'));
    $('b-hide').onclick = () => { S.settings.hide = !S.settings.hide; save(); openTrack(t.id); };
    $('b-romaji').onclick = () => { S.settings.romaji = S.settings.romaji === false; save(); openTrack(t.id); };
    $('b-mastered').onclick = () => {
      const r = S.songs[t.id] || { n: 0, best: 0 };
      r.mastered = !r.mastered; S.songs[t.id] = r; save(); openTrack(t.id);
    };

    function drawLyric(track) {
      const host = $('lyric');
      host.innerHTML = '';
      track.lines.forEach((l) => {
        if (!l.text.trim()) { const sp = document.createElement('div'); sp.className = 'space'; host.appendChild(sp); return; }
        const div = document.createElement('div');
        div.className = 'line' + (l.jp ? '' : ' en');
        if (l.segs && l.segs.length) {
          for (const seg of l.segs) {
            if (!seg.w) { div.appendChild(document.createTextNode(seg.s)); continue; }
            const w = VBY.get(seg.b) || { id: -1, word: seg.b, reading: seg.r, romaji: seg.y, forms: {}, count: 0, tracks: [] };
            const sp = document.createElement('span');
            sp.className = 'w' + (seg.b && VBY.has(seg.b) ? (isKnown(w) ? ' known' : (isNew(w) ? ' unknown' : '')) : '');
            sp.textContent = seg.s;
            sp.onclick = (e) => { e.stopPropagation(); if (VBY.has(seg.b)) showPop(VBY.get(seg.b)); };
            div.appendChild(sp);
          }
        } else {
          div.textContent = l.text;
        }
        div.onclick = () => speak(cleanForTTS(l.text));
        host.appendChild(div);
        if (S.settings.romaji !== false && l.romaji && l.jp) {
          const r = document.createElement('div'); r.className = 'romaji'; r.textContent = l.romaji; host.appendChild(r);
        }
      });
    }
  }

  // ---------- 单词卡 ----------
  function buildQueue() {
    const batch = 20;
    const due = VOCAB.filter(isDue);
    const fresh = VOCAB.filter(isNew);
    return { queue: [...due, ...fresh.slice(0, batch)], dueCount: due.length, newCount: Math.min(batch, fresh.length) };
  }
  function startSession() {
    const { queue } = buildQueue();
    session = { queue, i: 0, flipped: false, right: 0, wrong: 0 };
    renderCard();
    renderCardStats();
  }
  function renderCardStats() {
    const seen = VOCAB.filter((w) => st(w)).length;
    const known = VOCAB.filter(isKnown).length;
    const due = VOCAB.filter(isDue).length;
    $('s-total').textContent = VOCAB.length;
    $('s-seen').textContent = seen;
    $('s-known').textContent = known;
    $('s-due').textContent = due;
    $('p-bar').style.width = VOCAB.length ? (known / VOCAB.length) * 100 + '%' : '0';
  }
  function renderCard() {
    const card = $('flipcard');
    card.classList.remove('flipped');
    session.flipped = false;
    const w = session.queue[session.i];
    if (!w) {
      $('c-word').textContent = '🎉 今天的都过完了';
      $('c-pos').textContent = '';
      $('c-meaning').textContent = '—'; $('c-reading').textContent = ''; $('c-romaji').textContent = '';
      $('c-forms').textContent = '';
      $('c-src').textContent = `本轮：记住 ${session.right} 个 / 没记住 ${session.wrong} 个`;
      return;
    }
    $('c-word').textContent = w.word;
    $('c-pos').textContent = w.pos || '';
    $('c-reading').textContent = w.reading ? '（' + w.reading + '）' : '';
    $('c-romaji').textContent = w.romaji || '';
    $('c-meaning').textContent = w.pos === '名詞' ? '名词' : w.pos === '動詞' ? '动词' : w.pos === '形容詞' ? '形容词' : w.pos === '副詞' ? '副词' : '';
    const forms = Object.keys(w.forms || {}).filter((f) => f !== w.word).slice(0, 6);
    $('c-forms').textContent = forms.length ? '歌词里的形态：' + forms.map((f) => `${f}（${w.forms[f].reading || ''}）`).join('、') : '';
    const stt = st(w);
    $('c-src').textContent = `出现 ${w.count} 次 / ${w.tracks.length} 首` + (stt ? ` · 已学${stt.seen} 次${stt.wrong ? ` · 错过 ${stt.wrong} 次` : ''}` : ' · 新词');
  }
  function nextCard(ok) {
    const w = session.queue[session.i];
    if (w) { grade(w, ok); ok ? session.right++ : session.wrong++; }
    session.i++;
    renderCard();
    renderCardStats();
  }

  // ---------- 词表 ----------
  function renderVocab() {
    const f = $('vq').value.trim().toLowerCase();
    const hits = VOCAB.filter((w) => !f ||
      w.word.toLowerCase().includes(f) || w.reading.toLowerCase().includes(f) || w.romaji.toLowerCase().includes(f));
    $('vcount').textContent = `共 ${VOCAB.length} 个词，当前显示 ${hits.length} 个（按出现曲数排序）`;
    $('vocablist').innerHTML = hits.slice(0, 400).map((w) => `
      <div class="card vrow${isKnown(w) ? ' done' : ''}" data-wid="${w.id}">
        <span class="vw">${esc(w.word)}</span>
        <span class="vr">${esc(w.reading)}</span>
        <span class="vy">${esc(w.romaji)}</span>
        <span class="vc">${w.tracks.length} 首 / ${w.count} 次</span>
      </div>`).join('') || '<div class="empty">没有匹配的词</div>';
    $('vocablist').querySelectorAll('.vrow').forEach((el) => {
      el.onclick = () => showPop(VOCAB[Number(el.dataset.wid) - 1]);
    });
  }

  // ---------- 进度 ----------
  function renderStats() {
    const seen = VOCAB.filter((w) => st(w));
    const known = VOCAB.filter(isKnown);
    const wrong = seen.filter((w) => st(w).wrong > 0).sort((a, b) => st(b).wrong - st(a).wrong).slice(0, 10);
    const practiced = Object.entries(S.songs).filter(([, r]) => r.n > 0).sort((a, b) => b[1].n - a[1].n);
    $('statbox').innerHTML = `
      <div>词表总数 <b>${VOCAB.length}</b> · 已学 <b>${seen.length}</b> · 已掌握 <b>${known.length}</b> · 待复习 <b>${VOCAB.filter(isDue).length}</b></div>
      <div>连续学习 <b>${streak()}</b> 天 · 累计学习日 <b>${S.days.length}</b> 天</div>
      <div>练过歌词的曲目 <b>${practiced.length}</b> 首</div>
      <div style="margin-top:12px" class="hint">错得最多的词：${wrong.length ? wrong.map((w) => `${esc(w.word)}(${st(w).wrong})`).join('、') : '暂无'}</div>
      <div class="hint">练过的曲目：${practiced.length ? practiced.map(([id, r]) => `${esc(trackById.get(id)?.title || id)} ${r.best || 0}%`).join('、') : '暂无'}</div>
    `;
  }

  // ---------- 启动 ----------
  async function boot() {
    load();
    let data;
    try {
      const res = await fetch('data/index.json');
      data = await res.json();
    } catch (e) {
      document.querySelector('#tracklist').innerHTML =
        '<div class="empty">没能载入 data/index.json。<br>本地打开需要起一个静态服务（浏览器不允许 file:// 读 JSON）：<br><code>node ../scripts/serve.mjs</code></div>';
      return;
    }
    IDX = data;
    VOCAB = data.vocab;
    VBY = new Map(VOCAB.map((w) => [w.word, w]));
    trackById = new Map(data.tracks.map((t) => [t.id, t]));
    $('headstat').textContent = `${data.stats.tracks} 首曲目 · ${data.stats.originals} 个原曲 · ${data.stats.vocab} 个词 · 时间轴 ${data.stats.withTiming} 首`;
    $('genat').textContent = '生成于 ' + new Date(data.generatedAt).toLocaleString('zh-CN');
    renderIndex();
    renderCardStats();
    renderCard();
    renderVocab();

    // 交互绑定
    document.querySelectorAll('nav.tabs button').forEach((b) => (b.onclick = () => setTab(b.dataset.tab)));
    $('q').oninput = (e) => renderIndex(e.target.value);
    $('vq').oninput = renderVocab;
    $('flipcard').onclick = () => { session.flipped = !session.flipped; $('flipcard').classList.toggle('flipped', session.flipped); };
    $('b-speak').onclick = (e) => { e.stopPropagation(); const w = session.queue[session.i]; if (w) speak(w.word); };
    $('b-again').onclick = () => nextCard(false);
    $('b-know').onclick = () => nextCard(true);
    $('p-close').onclick = hidePop;
    $('p-speak').onclick = () => { const w = VOCAB[Number($('pop').dataset.wid) - 1]; if (w) speak(w.word); };
    $('p-known').onclick = () => {
      const w = VOCAB[Number($('pop').dataset.wid) - 1];
      if (!w) return;
      const s = S.words[w.id] || { st: 'learning', streak: 0, seen: 0, wrong: 0 };
      if (s.st === 'known') { s.st = 'learning'; s.streak = 0; s.due = addDays(1); }
      else { s.st = 'known'; s.streak = 3; s.due = null; }
      S.words[w.id] = s; markToday(); save();
      showPop(w); renderCardStats(); renderIndex($('q').value);
    };
    $('b-export').onclick = () => {
      const blob = new Blob([JSON.stringify(S, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `thlyrics-学习进度-${todayStr()}.json`;
      a.click();
    };
    $('b-import').onclick = () => $('file').click();
    $('file').onchange = async (e) => {
      const f = e.target.files[0]; if (!f) return;
      try { S = Object.assign(freshState(), JSON.parse(await f.text())); save(); renderCardStats(); renderCard(); renderStats(); renderIndex($('q').value); alert('导入成功'); }
      catch { alert('这个文件不是有效的进度 JSON'); }
    };
    $('b-reset').onclick = () => {
      if (confirm('清空本地学习进度？建议先导出备份。')) { S = freshState(); save(); renderCardStats(); renderCard(); renderStats(); renderIndex($('q').value); }
    };
    document.addEventListener('click', (e) => { if (!e.target.closest('#pop') && !e.target.closest('.w') && !e.target.closest('.vrow')) hidePop(); });
    window.addEventListener('keydown', (e) => {
      if (!document.getElementById('panel-cards').classList.contains('active')) return;
      if (e.key === ' ') { e.preventDefault(); $('flipcard').click(); }
      if (e.key === 'ArrowRight') nextCard(true);
      if (e.key === 'ArrowLeft') nextCard(false);
    });
  }

  boot();
})();
